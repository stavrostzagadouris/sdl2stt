#!/usr/bin/env bash
#
# talk — voice input: record -> STT -> type the transcript into the focused field.
#
#   talk start    begin a push-to-talk recording (ended by the watchdog, see below)
#   talk stop     stop, transcribe, wtype the result
#   talk toggle   start if idle, stop if recording
#   talk watchdog ends a push-to-talk hold when the key repeats stop (internal)
#
# talkwave captures the default source itself (libpulse pa_simple), so there's
# no external recorder and nothing lost on kill — it finalizes the WAV itself.
# STT endpoint: any OpenAI-compatible /v1/audio/transcriptions server.
# Configure with TALK_STT_URL (and optionally TALK_STT_PEER) — see README.
set -uo pipefail

# The compositor spawns us with PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:...
# which does NOT include ~/.local/bin, so `talkwave` would not resolve.
PATH="$HOME/.local/bin:$PATH"

STT_URL="${TALK_STT_URL:-http://127.0.0.1:5000/v1/audio/transcriptions}"
# Tailscale peer expected to host the STT server, used only to explain failures.
# Empty disables the Tailscale-specific diagnosis.
STT_PEER="${TALK_STT_PEER:-}"
STATE="$HOME/.cache/talk.state"
BEAT="$HOME/.cache/talk.beat"
LOG="$HOME/.cache/talk.log"
# Recordings are microphone audio: keep them in the per-user runtime dir (0700,
# tmpfs) rather than world-listable /tmp when there is one.
WAVDIR="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}"

mkdir -p "$(dirname "$STATE")"

log() { printf '%s %s\n' "$(date +%H:%M:%S)" "$*" >> "$LOG"; }

# Keep the log from growing without bound: past ~1 MB, keep the last 2000 lines.
trim_log() {
  local size
  size="$(stat -c %s "$LOG" 2>/dev/null || echo 0)"
  if [ "$size" -gt 1000000 ]; then
    tail -n 2000 "$LOG" > "$LOG.tmp" 2>/dev/null && mv -f "$LOG.tmp" "$LOG"
  fi
}

# True only if the state file names a process that is actually alive.
# A stale state file (recorder died) is cleared, so a failure can never
# wedge the toggle permanently.
recording() {
  [ -f "$STATE" ] || return 1
  local job _rest
  read -r job _rest < "$STATE"   # non-zero at EOF-without-newline; vars still set
  [ -n "${job:-}" ] || { rm -f "$STATE"; return 1; }
  if kill -0 "$job" 2>/dev/null; then return 0; fi
  log "clearing stale state (pid $job gone)"
  rm -f "$STATE"
  return 1
}

# True while the state file still names recorder $1. Pure bash, no fork: the
# watchdog calls this five times a second.
state_is() {
  [ -f "$STATE" ] || return 1
  local job _rest
  read -r job _rest < "$STATE" 2>/dev/null
  [ "${job:-}" = "$1" ]
}

# Watchdog for ONE recording: `talk watchdog <pid> <hold|cap>`.
#
# It is tied to the recorder's PID and exits as soon as the state file stops
# naming it, so a watchdog left over from an earlier recording can never end a
# later one.
#
# hold mode -- Hyprland never dispatches the SPACE keyup once the SUPER+SPACE
# press bind has consumed the press -- verified at the compositor: a bare-SPACE
# release bind fires for ordinary typed spaces and goes silent for the entire
# duration of the chord, in either release order. So the release event cannot
# be used to end a push-to-talk hold at all.
# Key REPEAT can: the press bind is `repeating`, and a repeat only matches
# while SUPER *and* SPACE are both still down -- lift either one, in either
# order, and the beats stop. The bind writes $BEAT on every repeat (in-process,
# see the Lua in README), this deletes it and watches for it to come back.
#
# "Delete it and see if it returns" rather than comparing mtimes keeps the poll
# to pure bash with no fork per tick. The 0.9 s grace clears the 600 ms
# repeat_delay before the first beat is due, so a short tap records ~1 s rather
# than being cut off -- raise it if your repeat_delay is longer.
#
# cap mode -- used by `talk toggle`, where nothing writes beats. Only the
# 2-minute backstop applies.
watchdog() {
  local pid="${1:-}" mode="${2:-hold}" waited=0
  [ -n "$pid" ] || return 0
  [ "$mode" = hold ] && sleep 0.9
  while state_is "$pid"; do
    [ "$mode" = hold ] && rm -f "$BEAT"
    sleep 0.2
    if [ "$mode" = hold ] && [ ! -f "$BEAT" ]; then
      log "watchdog: beats stopped, ending hold"
      stop stop repeat "$pid"
      return 0
    fi
    # Backstop: never record forever.
    waited=$((waited + 1))
    if [ "$waited" -gt 600 ]; then       # 600 * 0.2 s = 2 min
      log "watchdog: 2 min cap hit"
      stop stop cap "$pid"
      return 0
    fi
  done
}

# start [hold|cap] -- hold (default) is push-to-talk and needs the repeating
# bind to keep it alive; cap is for toggle use.
start() {
  local mode="${1:-hold}"
  trim_log
  # Push-to-talk: if a release event was missed (e.g. the modifier was let go
  # before the key), a recorder can still be alive. Clear it rather than
  # stacking a second one — that is what produced duplicate recorders.
  if recording; then
    local old oldwav; read -r old oldwav < "$STATE"
    log "start: clearing live recorder $old before restart"
    kill -TERM "$old" 2>/dev/null || true
    # Wait for it to exit BEFORE deleting: talkwave writes the WAV *on*
    # SIGTERM, so removing the file first would just leave the new one behind.
    for _ in $(seq 1 30); do
      kill -0 "$old" 2>/dev/null || break
      sleep 0.1
    done
    rm -f "$oldwav" "$oldwav.part" "$STATE"
  fi
  # mktemp creates the (empty) file itself, so the name is ours. talkwave
  # writes <wav>.part and renames it over this, which makes "non-empty" mean
  # "complete".
  local wav
  wav="$(mktemp --suffix=.wav "$WAVDIR/talk.XXXXXX")" || {
    log "start: mktemp failed in $WAVDIR"
    notify-send -u critical -a talk "Voice input failed" "Could not create a temp file in $WAVDIR."
    return 1
  }
  talkwave --out "$wav" >>"$LOG" 2>&1 &
  local job=$!
  printf '%s %s\n' "$job" "$wav" > "$STATE"
  log "start: pid $job -> $wav ($mode)"
  [ "$mode" = hold ] && : > "$BEAT"
  # setsid: the watchdog must outlive this invocation, which the compositor
  # reaps as soon as the bind's command returns.
  setsid -f "$0" watchdog "$job" "$mode" >/dev/null 2>&1
}

# Why did the endpoint not answer? Distinguishes the three cases that otherwise
# look identical: Tailscale down locally, the host offline/asleep, or the host
# up but the STT server not listening. Match the peer on DNSName as well as
# HostName -- a machine's HostName is often nothing like its tailnet name.
diagnose_failure() {
  [ -n "$STT_PEER" ] || { echo "The transcription server did not respond."; return; }
  command -v tailscale >/dev/null 2>&1 || {
    echo "Tailscale is not installed here."; return; }
  tailscale status --json 2>/dev/null | python3 -c '
import sys, json
peer = sys.argv[1].lower()
try:
    d = json.load(sys.stdin)
except Exception:
    print("Could not read Tailscale status."); raise SystemExit
state = d.get("BackendState")
if state != "Running":
    print("Tailscale is not connected here (state: %s)." % state); raise SystemExit
for pr in (d.get("Peer") or {}).values():
    ident = (pr.get("DNSName","") + " " + pr.get("HostName","")).lower()
    if peer in ident:
        if pr.get("Online"):
            print("%s is online, but the STT server is not answering." % peer)
        else:
            print("%s is offline - probably asleep. Wake it and try again." % peer)
        raise SystemExit
print("%s is not on the tailnet." % peer)
' "$STT_PEER" 2>/dev/null || echo "Could not reach Tailscale to diagnose."
}

# Gate, POST and parse one finished WAV. Prints the transcript on stdout (empty
# if there is nothing to type); every failure is logged and notified here.
transcribe() {
  local wav="$1"

  # Noise gate. Parakeet invents words out of room noise, and wtype would type
  # them into whatever field has focus. Measured on this mic at 40% volume:
  # background TV + conversation sits at window-RMS ~0.003, so a 0.02 floor with
  # a 3-window (60 ms total) minimum rejects the room but passes real speech.
  # Override with TALK_GATE=<rms>. Fails OPEN: a measurement error must never
  # silently discard a real recording.
  local gate="${TALK_GATE:-0.02}" meas pk lw verdict
  meas="$(python3 - "$wav" "$gate" <<'PYGATE'
import sys, wave, array, math
try:
    with wave.open(sys.argv[1], "rb") as w:
        if w.getsampwidth() != 2 or w.getnchannels() != 1:
            print("1.0 99 ok"); raise SystemExit
        a = array.array("h"); a.frombytes(w.readframes(w.getnframes()))
    if not len(a):
        print("0.0 0 quiet"); raise SystemExit
    thr = float(sys.argv[2]); win = 320; loud = 0; peak = 0.0
    for i in range(0, len(a) - win + 1, win):
        seg = a[i:i+win]
        r = math.sqrt(sum(float(x)*x for x in seg) / win) / 32768.0
        if r > peak: peak = r
        if r > thr: loud += 1
    print("%.4f %d %s" % (peak, loud, "ok" if loud >= 3 else "quiet"))
except SystemExit:
    raise
except Exception:
    print("1.0 99 ok")
PYGATE
)"
  read -r pk lw verdict <<< "$meas"
  log "stop: level peak=$pk loud_windows=$lw -> $verdict"
  if [ "$verdict" = "quiet" ]; then
    notify-send -a talk "Voice input" "No speech detected."
    return 0
  fi

  # --connect-timeout fails fast when the host is off/unreachable, instead of
  # sitting for the full --max-time with no feedback. Body and HTTP status are
  # captured separately so "unreachable" and "spoke but got nothing" are
  # distinguishable -- both were silent no-ops before.
  local body code
  body="$(curl -s -m 20 --connect-timeout 3 -w '\n%{http_code}' \
              -X POST "$STT_URL" -F "file=@$wav" 2>/dev/null)"
  local rc=$?
  code="${body##*$'\n'}"
  body="${body%$'\n'*}"

  if [ $rc -ne 0 ]; then
    local why; why="$(diagnose_failure)"
    log "stop: STT unreachable (curl rc=$rc) - $why"
    notify-send -u critical -a talk "Voice input failed" "$why Recording discarded."
    return 0
  fi
  if [ "$code" != "200" ]; then
    log "stop: STT HTTP $code"
    notify-send -u critical -a talk "Voice input failed" "Transcription server returned HTTP $code."
    return 0
  fi

  local text
  text="$(printf '%s' "$body" | python3 -c 'import sys, json
try:
    print(json.load(sys.stdin).get("text", "").strip())
except Exception:
    pass' 2>/dev/null)"

  if [ -z "$text" ]; then
    log "stop: empty transcription"
    notify-send -a talk "Voice input" "No speech detected."
    return 0
  fi
  printf '%s' "$text"
}

# stop <ignored> [trigger] [pid]
#   trigger  repeat | super | cap | toggle -- only for the log. It is what made
#            the original bug legible: every stop read "super", i.e. the keyup
#            path never once fired.
#   pid      if given, only stop the recording made by that recorder.
stop() {
  local trigger="${2:-?}" expect="${3:-}"
  # Silent no-op when idle. This matters: `stop` is also on a bare SUPER-release
  # bind (the panic key, see README) which fires on every SUPER+<anything>
  # chord, so logging here would bury the log in "not recording" lines.
  [ -f "$STATE" ] || return 0
  # A watchdog only ever stops its own recording.
  if [ -n "$expect" ] && ! state_is "$expect"; then return 0; fi

  # Claim the recording by renaming the state file. rename() is atomic, so when
  # the watchdog and the panic bind both fire for one release, exactly one of
  # them gets it -- without this both would transcribe and type the same clip.
  local claim="$STATE.$$" job wav
  mv "$STATE" "$claim" 2>/dev/null || return 0
  read -r job wav < "$claim"
  if [ -n "$expect" ] && [ "${job:-}" != "$expect" ]; then
    # It changed between the check above and the claim: hand it back untouched.
    mv "$claim" "$STATE"
    return 0
  fi
  rm -f "$claim"
  log "stop: triggered by $trigger"

  # SIGUSR1: talkwave stops capturing, writes the WAV, and keeps its bar on
  # screen as a "processing" sweep while we wait on the server.
  kill -USR1 "$job" 2>/dev/null || true
  # `wait` can't be used: talkwave was started by a *different* shell (the
  # `start` invocation), so it is not a child of this one and wait returns
  # immediately. Poll for the finished file instead -- or for the recorder
  # having died, in which case there is nothing more to wait for.
  for _ in $(seq 1 100); do
    [ -s "$wav" ] && break
    kill -0 "$job" 2>/dev/null || break
    sleep 0.05
  done

  local text=""
  if [ -s "$wav" ]; then
    text="$(transcribe "$wav")"
  else
    log "stop: no audio at $wav"
    notify-send -u critical -a talk "Voice input failed" \
      "The recorder produced no audio. See ~/.cache/talk.log."
  fi
  rm -f "$wav" "$wav.part"

  # Take the bar down BEFORE typing, and wait for it to go: if the compositor
  # gave the bar keyboard focus, wtype would otherwise type into the bar.
  kill -TERM "$job" 2>/dev/null || true
  for _ in $(seq 1 40); do
    kill -0 "$job" 2>/dev/null || break
    sleep 0.05
  done

  if [ -n "$text" ]; then
    sleep 0.05   # let focus settle back on the previous window
    log "stop: typing ${#text} chars"
    wtype -- "$text"
  fi
}

case "${1:-}" in
  start)    start hold ;;
  stop)     stop "$@" ;;
  watchdog) watchdog "${2:-}" "${3:-hold}" ;;
  toggle)   if recording; then stop stop toggle; else start cap; fi ;;
  *) echo "usage: talk {start|stop|toggle}" >&2; exit 2 ;;
esac
